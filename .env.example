# CampusRAG 환경 변수 설정
# 이 파일을 복사하여 .env로 이름을 변경한 후 값을 채워주세요.
# cp .env.example .env

# ── LLM Provider 선택 ──────────────────────────
# "local" (기본값) | "gemini" | "openai"
LLM_PROVIDER=local

# ── 로컬 LLM 설정 ─────────────────────────────
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_LLM_MAX_NEW_TOKENS=512

# ── Gemini API (선택) ──────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI API (선택) ──────────────────────────
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ── 임베딩 모델 ────────────────────────────────
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ── RAG 설정 ───────────────────────────────────
TOP_K=3
CHROMA_PERSIST_DIR=data/integrated_eval_chroma_db
CHROMA_COLLECTION_NAME=campus_knowledge
NOTICES_PATH=data/unified_campus_knowledge.json
