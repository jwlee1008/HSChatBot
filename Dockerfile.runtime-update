# Update app assets while retaining a verified runtime and installed packages.
# Pin RUNTIME_IMAGE to a saved local image or immutable digest before building.
ARG RUNTIME_IMAGE
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS web-build
WORKDIR /web
COPY frontend-web/package*.json ./
RUN npm ci
COPY frontend-web/ ./
RUN npm run build

FROM ${RUNTIME_IMAGE}
ARG SOURCE_REVISION
ARG RUNTIME_IMAGE
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/jwlee1008/HSChatBot" \
      org.opencontainers.image.base.name="${RUNTIME_IMAGE}"
WORKDIR /app
COPY backend/ backend/
COPY core/ core/
COPY config.py ./
COPY --from=web-build /web/dist frontend-web/dist/
